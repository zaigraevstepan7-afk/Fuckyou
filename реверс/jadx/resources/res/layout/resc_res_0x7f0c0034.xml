<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    style="@style/resc_res_0x7f10046f">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textAppearance="@style/resc_res_0x7f1001f1"
                android:textColor="@color/resc_res_0x7f050019"
                android:background="@drawable/resc_res_0x7f070079"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resc_res_0x7f0f0030"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
            <TextView
                android:textAppearance="@style/resc_res_0x7f1001f8"
                android:textColor="@color/resc_res_0x7f050315"
                android:ellipsize="end"
                android:id="@+id/resc_res_0x7f0901db"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="1"/>
            <TextView
                android:textAppearance="@style/resc_res_0x7f1001e9"
                android:textColor="@color/resc_res_0x7f050318"
                android:id="@+id/resc_res_0x7f0901da"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/resc_res_0x7f09006c"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resc_res_0x7f0f00c2"
                style="@style/resc_res_0x7f10046d"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/resc_res_0x7f090068"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/resc_res_0x7f0f0046"
                android:layout_marginStart="8dp"
                style="@style/resc_res_0x7f10046e"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
