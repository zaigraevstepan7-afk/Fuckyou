<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:id="@+id/resc_res_0x7f0901ff"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Preparing…"/>
    <ProgressBar
        android:id="@+id/resc_res_0x7f090172"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:max="100"
        android:indeterminate="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:gravity="end"
        android:id="@+id/resc_res_0x7f090201"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0%"/>
    <TextView
        android:id="@+id/resc_res_0x7f090202"
        android:paddingTop="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="— / — • — • —"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/resc_res_0x7f090200"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Downloading over HTTPS"
        android:alpha="0.7"/>
</LinearLayout>
