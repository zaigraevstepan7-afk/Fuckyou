<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#171311"
                android:endColor="#0b0a09"
                android:angle="270"/>
        </shape>
    </item>
    <item android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#26fb5755"
                android:endColor="#00fb5755"
                android:angle="270"/>
        </shape>
    </item>
</layer-list>
