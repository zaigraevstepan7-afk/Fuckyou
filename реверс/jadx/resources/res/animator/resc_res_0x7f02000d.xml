<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:state_enabled="true"
        android:state_hovered="true">
        <objectAnimator
            android:interpolator="?attr/resc_res_0x7f03033d"
            android:duration="?attr/resc_res_0x7f030333"
            android:valueTo="@dimen/resc_res_0x7f0600f1"
            android:valueType="floatType"
            android:propertyName="translationZ"
            android:startDelay="?attr/resc_res_0x7f030330"/>
    </item>
    <item
        android:state_enabled="true"
        app:state_dragged="true">
        <objectAnimator
            android:interpolator="?attr/resc_res_0x7f03033d"
            android:duration="?attr/resc_res_0x7f030333"
            android:valueTo="@dimen/resc_res_0x7f0600eb"
            android:valueType="floatType"
            android:propertyName="translationZ"
            android:startDelay="?attr/resc_res_0x7f030330"/>
    </item>
    <item android:state_enabled="true">
        <objectAnimator
            android:interpolator="?attr/resc_res_0x7f03033d"
            android:duration="?attr/resc_res_0x7f03032d"
            android:valueTo="0dp"
            android:valueType="floatType"
            android:propertyName="translationZ"/>
    </item>
    <item>
        <objectAnimator
            android:duration="0"
            android:valueTo="0dp"
            android:valueType="floatType"
            android:propertyName="translationZ"/>
    </item>
</selector>
